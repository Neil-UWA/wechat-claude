{
  "name": "wechat-claude-sessions",
  "version": "1.1.0",
  "description": "Control Claude Code via WeChat using the ilink Bot API",
  "type": "module",
  "license": "MIT",
  "author": "Neil Lu",
  "homepage": "https://github.com/Neil-UWA/wechat-claude",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neil-UWA/wechat-claude.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "bin": {
    "wechat-claude": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/server.js",
    "daemon": "node dist/cli.js daemon",
    "daemon:install": "node dist/cli.js daemon install",
    "daemon:uninstall": "node dist/cli.js daemon uninstall",
    "daemon:status": "node dist/cli.js daemon status",
    "daemon:log": "node dist/cli.js daemon log"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
